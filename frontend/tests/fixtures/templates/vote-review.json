        "position": {
          "x": 680,
          "y": 320
        },
        "config": {
          "tier": "cheap",
          "max_iter": 1,
          "guardrail_max_retries": 2,
          "prompt_inputs": {
            "draft": "${state.draft}"
          },
          "role": "Compliance Reviewer",
          "goal": "Catch the sentence that will have to be retracted.",
          "backstory": "You read for what a regulator, a customer lawyer or a competitor would do with a sentence. You are not looking for reasons to say no; you are looking for the one line that commits somebody to something.",
          "task": {
            "description": "Review the draft below for POLICY ONLY. Ignore accuracy and ignore tone; two colleagues are reading for those.\n\nREJECT if it names an unannounced customer, promises a date, states a performance figure without a qualifier, or compares us to a named competitor. APPROVE otherwise.\n\nDRAFT:\n{draft}",
            "expected_output": "An object with two keys: `verdict`, which is exactly APPROVE or REJECT, and `reason`, one sentence saying why.",
            "output_schema": {
              "verdict": "string",
              "reason": "string"
            },
