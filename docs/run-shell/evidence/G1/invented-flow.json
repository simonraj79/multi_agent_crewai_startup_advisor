        "role": "Handover Briefer",
        "goal": "Write the one page the staff room actually reads.",
        "backstory": "You write for people who are between patients. Short lines, the change first, the reason second, and never a table where a sentence would do.",
        "task": {
          "description": "Write the staff notice for next week from the rota and the cover plan below. Lead with what changed.\n\nROTA:\n{rota}\n\nCOVER:\n{cover}",
          "expected_output": "A one-page staff notice in Markdown: what changed, the rota, the cover.",
          "output_schema": null,
