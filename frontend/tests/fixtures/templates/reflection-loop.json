      },
      {
        "id": "e8",
        "source": "judge",
        "source_port": "done",
        "target": "final",
        "target_port": "in"
      },
      {
        "id": "e9",
        "source": "judge",
        "source_port": "again",
        "target": "generate",
        "target_port": "in"
      }
    ],
    "joins": {
      "judge": "all"
    },
