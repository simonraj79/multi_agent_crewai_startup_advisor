        "planning": false,
        "planning_config": null
      }
    },
    {
      "id": "confirm",
      "kind": "gate",
      "label": "Confirm the demand",
      "position": {
        "x": 360,
        "y": 320
      },
      "config": {
        "message": "This is the demand the rota will be built against, and everything below it costs money. Approve the forecast, or send it back with what it got wrong.",
        "editable_fields": [],
        "max_turns": 1,
        "expiry_seconds": 1800
      }
    },
    {
      "id": "draft",
      "kind": "agent",
      "label": "Draft the rota",
      "position": {
        "x": 360,
        "y": 480
      },
      "config": {
        "tier": "cheap",
        "max_iter": 2,
        "guardrail_max_retries": 2,
        "prompt_inputs": {
          "brief": "${state.brief}",
          "demand": "${state.out__forecast}",
          "notes": "${state.out__notes}"
        },
        "role": "Roster Architect",
        "goal": "Turn a demand table into a week somebody can actually work.",
        "backstory": "You build rotas back-to-front, from the hardest session to the easiest, because the last slot filled is always the one that breaks. If a redraft note arrives you fix every point in it rather than defending the draft.",
        "task": {
          "description": "Build the week's rota from the demand table below. If REDRAFT NOTES are present, fix every point in them.\n\nBRIEF:\n{brief}\n\nDEMAND:\n{demand}\n\nREDRAFT NOTES:\n{notes}",
          "expected_output": "A named rota: one row per session, the people on it, and who is on call.",
          "output_schema": null,
          "markdown": true,
          "async_execution": false
        },
        "llm": {
          "model": "google/gemini-3.5-flash-lite:nitro",
          "temperature": null,
          "top_p": null,
          "max_tokens": null,
          "timeout": null,
          "response_format": null,
          "frequency_penalty": null,
