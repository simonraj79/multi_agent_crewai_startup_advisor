        "config": {
          "tier": "cheap",
          "max_iter": 1,
          "guardrail_max_retries": 2,
          "prompt_inputs": {
            "reviews": "${state.out__votes}"
          },
          "role": "Returning Officer",
          "goal": "Count what the reviewers said, and add nothing to it.",
          "backstory": "You count. You have no opinion about the draft, you do not reread it, and you never break a tie yourself.",
          "task": {
            "description": "Below are three independent reviews, each carrying a `verdict` of APPROVE or REJECT.\n\nCount how many say APPROVE. Do not read the draft, do not weigh the reasons and do not change a verdict. Return the count, and the reasons from every review that said REJECT.\n\nREVIEWS:\n{reviews}",
