{
  "schema": "builder.flow/v1",
  "id": "ug_00000000",
  "name": "Clinic Rota Planner",
  "version": 1,
  "input_field": "brief",
  "nodes": [
    {
      "id": "brief",
      "kind": "input",
      "label": "Clinic brief",
      "position": {
        "x": 360,
        "y": 0
      },
      "config": {
        "field": "brief",
        "label": "Describe the week to be staffed",
        "max_chars": 2000,
        "required": true
      }
    },
    {
      "id": "forecast",
      "kind": "agent",
      "label": "Forecast demand",
      "position": {
        "x": 360,
        "y": 160
      },
      "config": {
        "tier": "cheap",
        "max_iter": 2,
        "guardrail_max_retries": 2,
        "prompt_inputs": {
          "brief": "${state.brief}"
        },
        "role": "Shift Demand Forecaster",
        "goal": "Say how many people each clinic session needs, and on what the number rests.",
        "backstory": "You have read appointment books for a decade. You count the sessions nobody remembers - the walk-in hour, the late list, the two afternoons a month the phlebotomist is in - and you would rather name an assumption than bury it.",
        "task": {
          "description": "Read the clinic brief below and produce a demand table: for every session of the week, how many clinical and how many reception staff are needed, and the one assumption each number rests on.\n\nBRIEF:\n{brief}",
          "expected_output": "A session-by-session demand table with a stated assumption per row.",
          "output_schema": null,
          "markdown": false,
          "async_execution": false
        },
        "llm": {
          "model": "google/gemini-3.5-flash-lite:nitro",
          "temperature": null,
          "top_p": null,
          "max_tokens": null,
          "timeout": null,
          "response_format": null,
          "frequency_penalty": null,
          "presence_penalty": null,
          "stop": [],
          "seed": null,
          "reasoning_effort": null
        },
        "max_rpm": null,
