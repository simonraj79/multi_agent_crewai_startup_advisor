  "id": "tiered-routing",
  "document": {
    "schema": "builder.flow/v1",
    "name": "Tiered routing",
    "version": 1,
    "input_field": "ticket",
    "nodes": [
      {
        "id": "ticket",
        "kind": "input",
        "label": "Ticket",
        "position": {
          "x": 340,
          "y": 0
        },
        "config": {
          "field": "ticket",
          "label": "Paste the message that arrived.",
          "max_chars": 2000,
          "required": true
        }
      },
      {
        "id": "confirm",
        "kind": "gate",
        "label": "Confirm the ticket",
        "position": {
          "x": 340,
          "y": 160
        },
        "config": {
          "message": "This message is about to be sorted. Most tickets are answered here without a model at all. Approve it, or send it back.",
          "editable_fields": [],
          "max_turns": 1,
          "expiry_seconds": 1800
        }
      },
      {
        "id": "triage",
        "kind": "router",
        "label": "Tier 1: can we answer this for free?",
        "position": {
          "x": 340,
          "y": 320
        },
        "config": {
          "branches": [
            {
              "label": "password",
              "op": "contains",
              "key": "ticket",
              "value": "password"
            },
            {
              "label": "tracking",
              "op": "contains",
              "key": "ticket",
              "value": "where is my order"
            },
            {
              "label": "unclear",
              "op": "otherwise",
              "key": null,
              "value": null
            }
          ]
        }
      },
      {
        "id": "reset_reply",
        "kind": "transform",
        "label": "Self-serve: password",
        "position": {
          "x": 40,
          "y": 480
        },
        "config": {
          "op": "format",
          "args": {
            "template": "You can reset your own password without waiting for us.\n\nOpen the sign-in page, choose \"Forgot password\", and enter the address you signed up with. The link we send is good for one hour. If it does not arrive, check the spam folder before writing back.\n\nYou asked:\n{ticket}",
            "ticket": "${state.ticket}"
          }
        }
      },
      {
        "id": "tracking_reply",
        "kind": "transform",
        "label": "Self-serve: order status",
        "position": {
          "x": 240,
          "y": 480
        },
        "config": {
          "op": "format",
          "args": {
            "template": "Every order has a live tracking page and it is quicker than we are.\n\nOpen Orders in your account and choose the order you are asking about. The page shows the carrier, the tracking number and the last scan. Orders placed after 4pm ship the following working day.\n\nYou asked:\n{ticket}",
            "ticket": "${state.ticket}"
          }
        }
      },
      {
        "id": "classify",
        "kind": "agent",
        "label": "Tier 2: how hard is this?",
        "position": {
          "x": 620,
          "y": 480
        },
        "config": {
          "tier": "cheap",
          "max_iter": 1,
          "guardrail_max_retries": 2,
          "prompt_inputs": {
            "ticket": "${state.ticket}"
          },
          "role": "Triage",
          "goal": "Say in one word how much thinking this ticket needs, and never more than that.",
          "backstory": "You sort the mail nobody could sort with a list of phrases. You read for the ask rather than the tone, you are paid to be quick rather than right about the answer, and you would rather send a borderline ticket up than guess at it yourself.",
          "task": {
            "description": "Read the ticket below and say how hard it is.\n\nAnswer `complex` when it needs judgement: several things going wrong at once, an account history to reconstruct, a policy question, or anything where a wrong answer costs money. Answer `ordinary` for everything else, which is most of it.\n\nTICKET:\n{ticket}",
            "expected_output": "An object with one key, `difficulty`, whose value is complex or ordinary.",
            "output_schema": {
              "difficulty": "string"
            },
            "markdown": false,
            "async_execution": false
          },
          "llm": {
            "model": "qwen/qwen3.7-flash",
            "temperature": null,
            "top_p": null,
            "max_tokens": null,
            "timeout": null,
            "response_format": null,
            "frequency_penalty": null,
            "presence_penalty": null,
            "stop": [],
            "seed": null,
            "reasoning_effort": null
          },
          "max_rpm": null,
          "max_execution_time": null,
          "allow_delegation": false,
          "memory": false,
          "cache": true,
          "respect_context_window": true,
          "retry": {
            "max_retries": 0,
            "backoff_seconds": 0,
            "fallback_model": null
          },
          "system_template": null,
          "prompt_template": null,
          "response_template": null,
          "tool_failure_policy": null,
          "planning": false,
          "planning_config": null
        }
      },
      {
        "id": "graded",
        "kind": "transform",
        "label": "Difficulty",
        "position": {
          "x": 620,
          "y": 640
        },
        "config": {
          "op": "pick",
          "args": {
            "source": "${state.out__classify}",
            "key": "difficulty"
          }
        }
      },
      {
        "id": "depth",
        "kind": "router",
        "label": "Tier 3: which model answers?",
        "position": {
          "x": 620,
          "y": 800
        },
        "config": {
          "branches": [
            {
              "label": "deep",
              "op": "eq",
              "key": "out__graded",
              "value": "complex"
            },
            {
              "label": "ordinary",
              "op": "otherwise",
              "key": null,
              "value": null
            }
          ]
        }
      },
      {
        "id": "specialist",
        "kind": "agent",
        "label": "Specialist",
        "position": {
          "x": 480,
          "y": 960
        },
        "config": {
          "tier": "escalation",
          "max_iter": 2,
          "guardrail_max_retries": 2,
          "prompt_inputs": {
            "ticket": "${state.ticket}"
          },
          "role": "Senior Support Specialist",
          "goal": "Untangle the hard ones completely, so nobody has to write in again.",
          "backstory": "You take what the desk could not. You reconstruct what happened from what the customer half remembers, you say what you are going to do before you do it, and you name the one thing you still need when you cannot finish.",
          "task": {
            "description": "Answer this ticket. It has been marked as needing judgement, so take the time.\n\nSay what you think happened, what you are doing about it, and what happens next. If you need one more fact to finish, ask for exactly that one thing.\n\nTICKET:\n{ticket}",
            "expected_output": "A reply the customer can read as-is: what happened, what has been done, what happens next, and at most one question.",
            "output_schema": null,
            "markdown": true,
            "async_execution": false
          },
          "llm": {
            "model": "google/gemini-3.8-flash",
            "temperature": null,
            "top_p": null,
            "max_tokens": null,
            "timeout": null,
            "response_format": null,
