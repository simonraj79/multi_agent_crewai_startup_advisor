          "expiry_seconds": 1800
        }
      },
      {
        "id": "answer",
        "kind": "agent",
        "label": "Write the reply",
        "position": {
          "x": 340,
          "y": 320
        },
        "config": {
          "tier": "cheap",
          "max_iter": 2,
          "guardrail_max_retries": 2,
          "prompt_inputs": {
            "enquiry": "${state.enquiry}",
            "notes": "${state.out__notes}"
          },
          "role": "Customer Reply Writer",
          "goal": "Write the reply that goes out, and rewrite it when the checker says why.",
          "backstory": "You write the replies a company signs its name to. You answer the question that was asked before anything else, you never promise a date you were not given, and you take a correction without arguing with it.",
          "task": {
            "description": "Write the reply to the enquiry below. If NOTES are present, your previous reply did not pass the check: rewrite it so every point in the notes is addressed.\n\nAnswer what was asked, say what happens next, and commit to nothing that is not in the enquiry.\n\nENQUIRY:\n{enquiry}\n\nNOTES:\n{notes}",
            "expected_output": "The reply itself, ready to send, with a greeting and a sign-off. Nothing about the reply and no notes to the reader.",
            "output_schema": null,
            "markdown": true,
            "async_execution": false
          },
          "llm": {
            "model": "google/gemini-3.5-flash-lite:nitro",
            "temperature": null,
            "top_p": null,
            "max_tokens": null,
            "timeout": null,
