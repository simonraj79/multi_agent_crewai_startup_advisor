          "fallback_model": null
        },
        "system_template": null,
        "prompt_template": null,
        "response_template": null,
        "tool_failure_policy": null,
        "planning": false,
        "planning_config": null
      }
    },
    {
      "id": "guidance",
      "kind": "tool",
      "label": "Read the rest rules",
      "position": {
        "x": 40,
        "y": 640
      },
      "config": {
        "tool_id": "scrape_website",
        "params": {},
        "credential_id": null
      }
    },
    {
      "id": "audit",
      "kind": "agent",
      "label": "Audit the rest rules",
      "position": {
        "x": 360,
        "y": 640
      },
      "config": {
        "tier": "cheap",
        "max_iter": 2,
        "guardrail_max_retries": 2,
        "prompt_inputs": {
          "rota": "${state.out__draft}",
          "brief": "${state.brief}"
        },
        "role": "Rest Rules Auditor",
        "goal": "Count the breaches in a rota and say exactly where each one is.",
        "backstory": "You check rotas against the published rest rules rather than against your memory of them, and you read the page again whenever a rota looks close. A breach you cannot point at is not a breach.",
        "task": {
          "description": "Audit the rota below against the rest rules named in the brief. Fetch the published guidance page if the brief gives one. Count the breaches and say where each is.\n\nROTA:\n{rota}\n\nBRIEF:\n{brief}",
          "expected_output": "An object with two keys: `breaches`, the whole number of rest-rule breaches found, and `notes`, what to change to clear them as one string.",
          "output_schema": {
            "breaches": "integer",
            "notes": "string"
          },
          "markdown": false,
          "async_execution": false
        },
        "llm": {
          "model": "google/gemini-3.5-flash-lite:nitro",
          "temperature": null,
          "top_p": null,
