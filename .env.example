# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. `.env` is gitignored and
# must never be committed.
#
#     cp .env.example .env          # bash
#     Copy-Item .env.example .env   # PowerShell
#
# Every variable below is listed with the file that actually reads it, so you
# can check any claim here against the source. Values are deliberately absent -
# this file documents names, never secrets.
#
# `.env` is loaded by python-dotenv at the repo root. VITE_API_URL is the one
# exception: it is read at frontend *build* time by Vite, so it belongs in
# `frontend/.env` locally, or in the static site's environment on Render.
# ---------------------------------------------------------------------------


# ===========================================================================
# Required - the model provider
# ===========================================================================

# OpenRouter is the ONLY LLM provider this project uses. Every agent model
# constant in src/brief_crew/config.py carries the `openrouter/` prefix, and
# service startup refuses to boot if one does not. There is no OpenAI
# fallback and OPENAI_API_KEY is not needed.
#
# Also used for embeddings, which are called directly rather than through
# CrewAI's embedder.
#
# Read by: src/brief_crew/embeddings.py, and by CrewAI's native OpenRouter
#          provider for every agent LLM call.
# Get one at: https://openrouter.ai/keys
OPENROUTER_API_KEY=


# ===========================================================================
# Required for Brief Crew (both tracks) and the validator's market branch
# ===========================================================================

# Firecrawl v2 search + scrape. Brief Crew's Researcher uses it to gather
# sources; Validator Studio's Market Analyst uses it for competitor research.
# Without it the market branch reports a `failed` envelope rather than
# inventing results - the run continues, with less evidence.
#
# Read by: src/brief_crew/tools/market_research.py
# Get one at: https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=


# ===========================================================================
# Required for the warm cache (Brief Crew Track B, validator market cache)
# ===========================================================================

# Pinecone serverless vector index. Holds the warm cache that makes repeat
# runs cheaper. Track A (`run_crew`) does not need it; Track B (`kickoff`)
# and the validator's market/feasibility cache do.
#
# Read by: src/brief_crew/indexing.py,
#          src/brief_crew/tools/pinecone_retrieval.py
# Get one at: https://app.pinecone.io
PINECONE_API_KEY=

# Name of the Pinecone index to use. You must create this index yourself:
# 768 dimensions, cosine metric, serverless. The dimension is not negotiable -
# embeddings are truncated to 768 via the `dimensions` parameter, and a
# mismatch fails upserts silently rather than raising.
#
# Read by: src/brief_crew/config.py (PINECONE_INDEX_NAME)
# Default if unset: agentic-crew-ai-index
PINECONE_INDEX_NAME=

# Cohere rerank, stage 2 of retrieval. Pinecone returns 20 candidates; Cohere
# reranks them and the top 5 reach the agent. The cache-hit gate thresholds
# are defined against the rerank score, so this is not optional for Track B.
#
# Read by: src/brief_crew/tools/pinecone_retrieval.py
# Get one at: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=


# ===========================================================================
# Optional - raises a rate limit, changes no behaviour
# ===========================================================================

# GitHub personal access token for the validator's Feasibility Analyst, which
# searches public repositories. No scopes are required - a token with no
# permissions at all still raises the shared search rate limit from 8 to 24
# requests/minute. Leave it blank to run unauthenticated.
#
# Read by: src/brief_crew/tools/github_feasibility.py
GITHUB_TOKEN=


# ===========================================================================
# Optional - service runtime (Validator Studio API)
# ===========================================================================

# SQLAlchemy database URL for durable run state, frames and human gates.
# Leave unset for local use: the service falls back to a SQLite file at
# output/validator-studio.db. Set it to a PostgreSQL URL in production;
# `postgres://` and `postgresql://` are both rewritten to `postgresql+psycopg://`
# automatically, so you can paste Render's connection string unchanged.
#
# Read by: src/brief_crew/service/app.py
DATABASE_URL=

# Interface the API binds to. The default is correct for local development
# and wrong for a container, where nothing outside can reach the loopback
# address. Set 0.0.0.0 if you use the `serve` console script as a container
# entry point. (render.yaml sidesteps this by invoking uvicorn explicitly.)
#
# Read by: src/brief_crew/service/app.py
# Default if unset: 127.0.0.1
HOST=

# Port the API listens on. Render injects this automatically.
#
# Read by: src/brief_crew/service/app.py
# Default if unset: 8000
PORT=

# How many workflow runs may execute concurrently. One run is roughly the
# memory ceiling on a 512 MB instance (~210 MB baseline per run), which is why
# the default is 1. Must be a positive integer or startup raises.
#
# Read by: src/brief_crew/config.py
# Default if unset: 1
RUN_CONCURRENCY=

# Which browser origins may call this API cross-origin. Comma-separated,
# each one a scheme + host + optional port with NO path and NO trailing
# slash (`https://studio.example.com`, `http://localhost:5173`). A malformed
# entry stops startup and the error names the corrected string to write.
#
# Leave it EMPTY locally. `frontend/vite.config.ts` proxies /api and /ws to
# this process, so the browser sees one origin and never performs a CORS
# check. It matters in production, where the Vue app is a separate static
# site: without its origin listed here every fetch is blocked by the browser
# and the console falls back to its scripted mock.
#
# `*` is accepted as an explicit opt-in (on its own, not mixed with names).
# It is only safe because this API has no cookie or header auth to abuse - a
# run is reached by an unguessable run_id. If auth is ever added, credentials
# must go on and `*` must be refused in the same change.
#
# NOTE: this does not govern the WebSocket. Browsers do not apply CORS to a
# WebSocket handshake, so /ws is reachable cross-origin regardless.
#
# Read by: src/brief_crew/config.py
# Default if unset: empty - no cross-origin caller at all
CORS_ALLOW_ORIGINS=

# Start the service with no-cost doubles instead of the real crews. The
# registered `serve` script hands uvicorn a factory BY NAME, and a string
# factory cannot carry keyword arguments - so without this the console script
# could only ever build the paid runners, and anyone starting the app just to
# look at the UI would spend real OpenRouter and Firecrawl credit the moment
# they pressed Launch.
#
# Set it to 1/true/yes/on for a free local run. NEVER set it on a deployed
# instance: nothing in the UI distinguishes synthetic from real, so a live
# deployment in this mode would hand people fabricated verdicts.
#
# Read by: src/brief_crew/service/app.py (app_from_env)
# Default if unset: off - the real, paid runners
SYNTHETIC=

# Let a client ask for an UNATTENDED run - the service answers the scope and
# verdict gates itself and the pipeline goes end to end without stopping.
#
# The Vue console defaults its GATES toggle to Unattended, so on a server
# without this every Launch fails with 403 ("unattended runs are disabled on
# this deployment"). 403 rather than 422 is deliberate: the request is well
# formed and would be honoured elsewhere, so a client can tell "I sent this
# wrong" apart from "this server will not do that".
#
# READ THIS BEFORE SETTING IT ON A PUBLIC DEPLOYMENT. POST /runs is
# unauthenticated by design, and human inaction was the de facto spend cap: a
# gated run stops after one Scoper call and expires if nobody replies. An
# unattended run has no such brake - Scoper, three live research branches,
# Synthesist at reasoning_effort=high, then Reporter - bounded only by
# MAX_RUN_COST_USD and the agents' summed max_iter. RUN_RATE_LIMIT_MAX_RUNS was
# calibrated against runs that stop at the first gate; ten COMPLETE pipelines a
# minute is a different order of spend. Correct for a local single-operator
# console; a deliberate decision anywhere else.
# Accepts: 1, true, yes, on (anything else is false)
#
# Read by: src/brief_crew/service/app.py (create_run)
# Default if unset: off - `gates=auto` is refused with 403
VALIDATOR_ALLOW_AUTO_GATES=

# Hard ceiling on one run's estimated LLM spend, in US dollars. A RUNAWAY
# brake, not a budget. It matters more once VALIDATOR_ALLOW_AUTO_GATES is on,
# because it is then the ONLY bound on a run nobody is watching.
#
# 0 disables the ceiling; UNSET does not - leaving it out keeps the default, so
# turning it off takes a deliberate MAX_RUN_COST_USD=0. The figure is tokens x
# a local price table and is blind to embeddings, Cohere rerank and Firecrawl,
# so the enforced total is always a lower bound on true spend.
#
# Read by: src/brief_crew/config.py
# Default if unset: 10.0
MAX_RUN_COST_USD=

# How long a gate reply waits for the run that opened the gate to finish
# settling before the service refuses the reply.
#
# The gate is published from inside the worker - durable row, WAITING status,
# GATE_OPEN frame - and only *then* does that worker return. A reply landing in
# that window used to be refused as "already executing", and because the reply
# had already been durably accepted the run wedged: RUNNING forever, no gate to
# answer, 409 on every retry, and it survived a restart. This is the wait that
# closes it. A refusal after the wait rolls the gate back open and answers 503.
#
# Read by: src/brief_crew/config.py
# Default if unset: 5.0 seconds
RUN_SUBMIT_SETTLE_TIMEOUT_SECONDS=

# How many runs may be queued or executing before the service starts refusing
# new ones with 429. This bounds ADMISSION; RUN_CONCURRENCY above bounds
# parallelism, which is not the same thing - the executor's internal queue is
# unbounded, so without this a flood of anonymous runs queues forever and
# starves your own. A run WAITING at a human gate does not hold a slot.
#
# Read by: src/brief_crew/config.py
# Default if unset: 8
MAX_QUEUED_RUNS=

# Per-client burst allowance for run creation only (health checks and the
# read-only GETs are never limited). Set to 0 to disable, which is the
# intended escape hatch. This is a courtesy limiter, not a security control:
# it is in-process, so it does not survive a restart and does not coordinate
# across instances.
#
# Read by: src/brief_crew/config.py
# Default if unset: 10 runs, refilling over a 60s window
RUN_RATE_LIMIT_MAX_RUNS=

# Serve /docs, /redoc and /openapi.json. Off by default on a deployed
# instance: they are 404 rather than removed, so this is obscurity and not a
# control - the endpoints are unchanged and findable either way. It simply
# stops handing a passer-by the exact body shape of the one endpoint that
# spends money. Synthetic mode turns them on automatically.
#
# Read by: src/brief_crew/config.py
# Default if unset: off
EXPOSE_API_DOCS=

# Over what window RUN_RATE_LIMIT_MAX_RUNS refills. The bucket regains one
# token every window/max_runs seconds, so the defaults give a burst of 10 and
# then one run per 6 seconds.
#
# Read by: src/brief_crew/config.py
# Default if unset: 60.0
RUN_RATE_LIMIT_WINDOW_SECONDS=

# Whether to read the client's address from the X-Forwarded-For header.
#
# **Check this one before deploying anywhere that is not behind a proxy.**
# Behind Render the socket peer IS the proxy, so with this off every visitor on
# earth shares a single bucket and the second person to press Launch is rate
# limited. Directly exposed, the reverse is true: the header is attacker
# supplied, so leaving this on lets anyone mint a fresh bucket per request and
# the limiter stops limiting.
#
# Read by: src/brief_crew/config.py
# Default if unset: on - correct behind Render, wrong if you move off it
RUN_RATE_LIMIT_TRUST_FORWARDED_FOR=

# NOTE: the remaining admission-control numbers really are CONSTANTS in
# src/brief_crew/config.py, with no env override - MAX_REQUEST_BODY_BYTES
# (64 KiB, answered as 413), MAX_RUN_INPUT_CHARS (2000, the bound on the one
# input that becomes a model prompt), MAX_RUN_INPUT_KEYS (16),
# MAX_RUN_INPUT_BYTES (8 KiB), RUN_ADMISSION_RETRY_AFTER_SECONDS (30),
# RUN_RATE_LIMIT_MAX_CLIENTS (4096) and RUN_RATE_LIMIT_KEY_MAX_CHARS (64).
# Change those in a commit, not a dashboard.
#
# To regenerate this list, do NOT use a line-based grep: four of the calls in
# config.py wrap the variable name onto the next line, and a `grep -oE` misses
# them - which is exactly how an earlier pass came to document two live knobs
# as hard-coded. Match across newlines instead, e.g. with `grep -Pzo` or:
#   python -c "import re,pathlib;print(sorted(set(re.findall(r'(?:os\.getenv|_env_[a-z_]+)\s*\(\s*\"([A-Z_]+)\"', pathlib.Path('src/brief_crew/config.py').read_text(), re.S))))"


# ===========================================================================
# Optional - validator cache and fan-out behaviour
# ===========================================================================

# Opaque per-user namespace for the validator's Pinecone cache, so one user's
# cached evidence cannot leak into another's run. Hashed before use; the raw
# value never reaches Pinecone. Leave unset for single-user local runs.
#
# Read by: src/brief_crew/validator_cache.py
VALIDATOR_CACHE_NAMESPACE=

# Enable the feasibility branch's cache. Off by default. Its purpose is to
# absorb GitHub rate-limit shocks, not to save money - cached evidence
# supplements a live branch, it never skips one.
# Accepts: 1, true, yes, on (anything else is false)
#
# Read by: src/brief_crew/config.py
# Default if unset: false
VALIDATOR_FEASIBILITY_CACHE_ENABLED=

# Force the three research branches to run one at a time instead of in
# parallel. This exists as a deploy-time escape hatch for the fan-out, and for
# the sequential arm of the benchmark harness - not as a normal setting.
# Accepts: 1, true, yes, on (anything else is false)
#
# Read by: src/brief_crew/config.py
# Default if unset: false
VALIDATOR_SEQUENTIAL_BRANCHES=


# ===========================================================================
# Optional - CrewAI telemetry and tracing
# ===========================================================================

# Opt out of CrewAI's OpenTelemetry exporter, so a run makes no telemetry
# HTTP call. The benchmark harness sets all three by default.
#
# Read by: CrewAI itself; scripts/perf_metrics.py sets them via setdefault
CREWAI_DISABLE_TELEMETRY=
CREWAI_DISABLE_TRACKING=
OTEL_SDK_DISABLED=

# Enable CrewAI AMP tracing. Locally, run `crewai login` once first and you
# get authenticated traces in your dashboard. From a container you get
# *ephemeral* traces instead: the credential is an encrypted tokens.enc file
# written by an interactive login, it expires, and there is no env-var
# equivalent. Never bake tokens.enc into an image.
#
# Traces can include prompts, task inputs and outputs, tool arguments and
# results, and model responses. Check what a trace contains before sharing
# its URL.
#
# Read by: CrewAI itself
CREWAI_TRACING_ENABLED=

# Pin CrewAI's local storage directory. Worth setting explicitly, because
# otherwise CrewAI derives it from the current working directory's name.
#
# Read by: CrewAI itself
CREWAI_STORAGE_DIR=


# ===========================================================================
# Frontend (build time) - put this in frontend/.env, not here
# ===========================================================================

# Origin of the API the Validator Studio UI talks to. Baked in at build time
# by Vite, so changing it requires a rebuild.
#
# MUST be a full origin including the scheme:
#     VITE_API_URL=https://your-api-host.example.com
# A bare hostname is not enough. The value is used both as a fetch prefix and
# as the base of `new URL(...)` for the WebSocket, so a scheme-less value
# resolves as a relative path, /ws never connects, and the UI silently falls
# back to its scripted mock - showing fabricated data that looks real.
#
# Leave unset for local development: Vite's dev server proxies /api and /ws
# to 127.0.0.1:8000 already.
#
# Read by: frontend/src/services/studioApi.ts
VITE_API_URL=
