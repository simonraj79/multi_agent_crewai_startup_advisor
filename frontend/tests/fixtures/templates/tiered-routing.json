      {
        "id": "standard",
        "kind": "agent",
        "label": "Support desk",
        "position": {
          "x": 800,
          "y": 960
        },
        "config": {
          "tier": "cheap",
          "max_iter": 2,
          "guardrail_max_retries": 2,
          "prompt_inputs": {
            "ticket": "${state.ticket}"
          },
          "role": "Support Agent",
          "goal": "Answer an ordinary ticket properly the first time.",
          "backstory": "You clear the queue. You answer what was asked, in the order it was asked, and you do not pad a short answer to look thorough.",
          "task": {
            "description": "Answer this ticket.\n\nAnswer what was asked and say what happens next. Keep it short.\n\nTICKET:\n{ticket}",
            "expected_output": "A short reply the customer can read as-is, with a clear next step.",
            "output_schema": null,
