  "id": "reflection-loop",
  "document": {
    "schema": "builder.flow/v1",
    "name": "Reflection loop",
    "version": 1,
    "input_field": "ask",
    "nodes": [
      {
        "id": "ask",
        "kind": "input",
        "label": "Ask",
        "position": {
          "x": 340,
          "y": 0
        },
        "config": {
          "field": "ask",
          "label": "What should be drafted?",
          "max_chars": 2000,
          "required": true
        }
      },
      {
        "id": "confirm",
        "kind": "gate",
        "label": "Confirm the ask",
        "position": {
          "x": 340,
          "y": 160
        },
        "config": {
          "message": "A drafter and a critic are about to go round on this, up to four times. Approve the ask, or send it back.",
          "editable_fields": [],
          "max_turns": 1,
          "expiry_seconds": 1800
        }
      },
      {
        "id": "generate",
        "kind": "agent",
        "label": "Draft",
        "position": {
          "x": 340,
          "y": 320
        },
        "config": {
          "tier": "cheap",
          "max_iter": 2,
          "guardrail_max_retries": 2,
          "prompt_inputs": {
            "ask": "${state.ask}",
            "feedback": "${state.out__feedback}"
          },
          "role": "Drafter",
          "goal": "Produce a draft, and improve it whenever somebody says how.",
          "backstory": "You write first drafts fast and you do not defend them. When a critic gives you three fixes you make all three, rather than arguing with one.",
          "task": {
            "description": "Draft the piece described below. If FEEDBACK is present, revise your previous draft to address every point in it.\n\nASK:\n{ask}\n\nFEEDBACK:\n{feedback}",
            "expected_output": "The draft itself, in Markdown, and nothing about the draft.",
            "output_schema": null,
            "markdown": true,
            "async_execution": false
          },
          "llm": {
            "model": "google/gemini-3.5-flash-lite:nitro",
            "temperature": null,
            "top_p": null,
            "max_tokens": null,
            "timeout": null,
            "response_format": null,
            "frequency_penalty": null,
            "presence_penalty": null,
            "stop": [],
            "seed": null,
            "reasoning_effort": null
          },
          "max_rpm": null,
          "max_execution_time": null,
          "allow_delegation": false,
          "memory": false,
          "cache": true,
          "respect_context_window": true,
          "retry": {
            "max_retries": 0,
            "backoff_seconds": 0,
            "fallback_model": null
          },
          "system_template": null,
          "prompt_template": null,
          "response_template": null,
          "tool_failure_policy": null,
          "planning": false,
          "planning_config": null
        }
      },
      {
        "id": "critique",
        "kind": "agent",
        "label": "Critique",
        "position": {
          "x": 340,
          "y": 480
        },
        "config": {
          "tier": "cheap",
          "max_iter": 2,
          "guardrail_max_retries": 2,
          "prompt_inputs": {
            "draft": "${state.out__generate}"
          },
          "role": "Critic",
          "goal": "Say how good this is, on a scale, and what would most improve it.",
          "backstory": "You review as an editor rather than as a fan. You give a number you would defend and three fixes ordered by how much each one buys.",
          "task": {
            "description": "Score the draft below out of 10 and give the three most important fixes.\n\nDRAFT:\n{draft}",
            "expected_output": "An object with two keys: `score`, a whole number 0 to 10, and `feedback`, the three fixes as one string.",
            "output_schema": {
              "score": "integer",
              "feedback": "string"
            },
            "markdown": false,
            "async_execution": false
          },
          "llm": {
            "model": "google/gemini-3.5-flash-lite:nitro",
            "temperature": null,
            "top_p": null,
            "max_tokens": null,
            "timeout": null,
            "response_format": null,
            "frequency_penalty": null,
            "presence_penalty": null,
            "stop": [],
            "seed": null,
            "reasoning_effort": null
          },
          "max_rpm": null,
          "max_execution_time": null,
          "allow_delegation": false,
          "memory": false,
          "cache": true,
          "respect_context_window": true,
          "retry": {
            "max_retries": 0,
            "backoff_seconds": 0,
            "fallback_model": null
          },
          "system_template": null,
          "prompt_template": null,
          "response_template": null,
          "tool_failure_policy": null,
          "planning": false,
          "planning_config": null
        }
      },
      {
        "id": "score",
        "kind": "transform",
        "label": "Score",
        "position": {
          "x": 140,
          "y": 640
        },
        "config": {
          "op": "pick",
          "args": {
            "source": "${state.out__critique}",
            "key": "score"
          }
        }
      },
      {
        "id": "feedback",
        "kind": "transform",
        "label": "Feedback",
        "position": {
          "x": 540,
          "y": 640
        },
        "config": {
          "op": "pick",
          "args": {
            "source": "${state.out__critique}",
            "key": "feedback"
          }
        }
      },
      {
        "id": "judge",
        "kind": "router",
        "label": "Good enough?",
        "position": {
          "x": 340,
          "y": 800
        },
        "config": {
          "branches": [
            {
              "label": "again",
              "op": "lt",
              "key": "out__score",
              "value": 8
            },
            {
              "label": "done",
              "op": "otherwise",
              "key": null,
              "value": null
            }
          ]
        }
      },
      {
        "id": "final",
        "kind": "output",
        "label": "Final draft",
        "position": {
          "x": 340,
          "y": 960
        },
        "config": {
          "body_key": "markdown_body",
          "source": "${state.out__generate}"
        }
      }
    ],
