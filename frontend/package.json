{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build && tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:e2e": "vite --config e2e/vite.e2e.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node server-dist/index.js",
    "dev:server": "node --watch server/index.ts",
    "auth:migrate": "npx --yes auth@latest migrate --config server/auth.ts -y",
    "auth:generate": "npx --yes auth@latest generate --config server/auth.ts -y"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "better-auth": "^1.7.2",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "hono": "^4.13.5",
    "lucide-vue-next": "^1.0.0",
    "pg": "^8.23.0",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
